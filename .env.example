# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase Postgres connection string for Prisma)
DATABASE_URL=

# App URL (used for rotating QR check-in links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sheets sync
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Optional: protect cron endpoint (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Optional: additional signing secret for rotating tokens (tokens are DB-stored by default)
QR_TOKEN_SECRET=
