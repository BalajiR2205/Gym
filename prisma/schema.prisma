// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name       String
  last_name        String
  phone            String   @unique
  email            String?
  photo_url        String?
  plan             Plan
  joined_at        DateTime @db.Date
  expires_at       DateTime @db.Date
  date_of_birth    DateTime? @db.Date
  member_number    Int      @unique @default(autoincrement())
  status           MemberStatus @default(ACTIVE)
  auth_user_id     String?  @db.Uuid
  personal_qr_secret String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  attendance Attendance[]
  sessions   MemberSession[]
  otps       LoginOtp[]

  @@index([phone])
  @@index([member_number])
  @@map("members")
}

model Staff {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id  String   @unique @db.Uuid
  full_name     String?
  role          StaffRole
  created_at    DateTime @default(now())

  attendance_marked Attendance[] @relation("AttendanceMarkedBy")

  @@map("staff")
}

model Attendance {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id    String   @db.Uuid
  checked_in_at DateTime @default(now())
  method       CheckinMethod
  marked_by    String?  @db.Uuid
  created_at   DateTime @default(now())

  member Member @relation(fields: [member_id], references: [id])
  staff  Staff? @relation("AttendanceMarkedBy", fields: [marked_by], references: [id])

  @@index([member_id])
  @@index([checked_in_at])
  @@map("attendance")
}

model CheckinToken {
  token              String   @id
  window_start       DateTime
  expires_at         DateTime
  used_by_member_ids String[] @default([]) @db.Uuid

  @@map("checkin_tokens")
}

model SyncState {
  id           String   @id @default("default")
  last_synced_at DateTime @default(now())

  @@map("sync_state")
}

model AdminSession {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_token_hash String    @unique
  username           String
  role               StaffRole @default(ADMIN)
  created_at         DateTime  @default(now())
  expires_at         DateTime
  last_used_at       DateTime  @default(now())

  @@index([session_token_hash])
  @@index([expires_at])
  @@map("admin_sessions")
}

model MemberSession {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_token_hash String    @unique
  member_id          String    @db.Uuid
  created_at         DateTime  @default(now())
  expires_at         DateTime
  last_used_at       DateTime  @default(now())

  member             Member    @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([session_token_hash])
  @@index([member_id])
  @@index([expires_at])
  @@map("member_sessions")
}

model LoginOtp {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id     String    @db.Uuid
  otp_hash      String
  purpose       String    @default("MEMBER_LOGIN")
  expires_at    DateTime
  attempt_count Int       @default(0)
  max_attempts  Int       @default(5)
  used_at       DateTime?
  last_sent_at  DateTime  @default(now())
  created_at    DateTime  @default(now())

  member        Member    @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id])
  @@index([expires_at])
  @@map("login_otps")
}

model RateLimitAttempt {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String
  created_at DateTime @default(now())

  @@index([key, created_at])
  @@map("rate_limit_attempts")
}

enum Plan {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum MemberStatus {
  ACTIVE
  EXPIRED
  FROZEN
}

enum CheckinMethod {
  SELF_SCAN
  STAFF_SCAN
}

enum StaffRole {
  ADMIN
  FRONT_DESK
  TRAINER
}